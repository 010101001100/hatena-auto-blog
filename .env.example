# 既存設定との互換性のためSecret名はOPENAI_API_KEYですが、中身はGemini APIキーです。
OPENAI_API_KEY=your_gemini_api_key

HATENA_ID=your_hatena_id
HATENA_BLOG_ID=example.hatenablog.com
HATENA_API_KEY=your_hatena_api_key

# 空欄ならPC・スマホ・Web/AIツールの実用記事に絞ります。
BLOG_THEME=

# workflowでは通常、自動公開します。
HATENA_DRAFT=false

# ローカル確認時だけtrueにすると投稿しません。
DRY_RUN=true
