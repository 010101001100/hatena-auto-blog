OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

HATENA_ID=your_hatena_id
HATENA_BLOG_ID=example.hatenablog.com
HATENA_API_KEY=your_hatena_api_key

# あなたのブログのジャンルを具体的に書く
BLOG_THEME=例：一人暮らしの家事を楽にする実用ノウハウ

# markdown / hatena / plain
BLOG_SYNTAX=markdown

# カンマ区切り。不要なら空欄
BLOG_CATEGORIES=生活,便利

# false = 自動公開 / true = 下書き
HATENA_DRAFT=true

# trueなら生成だけして投稿しない
DRY_RUN=false
