# Gemini API
# 推奨Secret名。旧OPENAI_API_KEYでもworkflow側で互換対応しています。
GEMINI_API_KEY=your_gemini_api_key

HATENA_ID=your_hatena_id
HATENA_BLOG_ID=example.hatenablog.com
HATENA_API_KEY=your_hatena_api_key

# 空欄ならPC・スマホ・Web/AIツールの実用記事に絞ります。
BLOG_THEME=

RESEARCH_MODEL=gemini-3.8-flash
WRITER_MODEL=gemini-3.8-flash
CRITIC_MODEL=gemini-3.8-flash

HATENA_DRAFT=false
DRY_RUN=true
